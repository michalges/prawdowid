# --- LLM (CONCEPT §3). Only the key is required for the default setup. -----------------
# openrouter (default) | mistral | openai | anthropic | ollama | mock (offline, never gives verdicts) | failing
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Default for openrouter: google/gemini-3.8-flash (fast). EU vendor option: mistralai/mistral-large-4-0. Any OpenRouter model id with structured outputs works.
# Cheap model for development: LLM_MODEL=qwen/qwen3.8-flash
LLM_MODEL=
# Key for mistral/openai/anthropic (openrouter uses OPENROUTER_API_KEY)
LLM_API_KEY=
# Optional override (e.g. http://ollama:11434 for self-hosted)
LLM_BASE_URL=
LLM_TIMEOUT_S=25
# USD per 1M tokens, for cost reporting. Known defaults exist for the default model.
LLM_PRICE_INPUT_PER_MTOK_USD=
LLM_PRICE_OUTPUT_PER_MTOK_USD=
# Ask OpenRouter to route only to providers that don't store/train on prompts
OPENROUTER_DENY_DATA_COLLECTION=true
# Process prompts only on EU/EEA/UK/CH endpoints (eu.openrouter.ai). Needs a Business/Enterprise plan, otherwise every call returns 403.
OPENROUTER_EU_ROUTING=false

# --- Retrieval / OCR ------------------------------------------------------------------
# hashing (offline, default) | sentence_transformers (needs `uv sync --extra embeddings`; rebuild corpus after switching)
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=intfloat/multilingual-e5-base
# tesseract (needs the binary + `pol` data; included in the Docker image) | none
OCR_PROVIDER=tesseract

# --- Policy ---------------------------------------------------------------------------
RETENTION_DAYS=30
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=200

# --- Admin & information loop -----------------------------------------------------------
# Bearer token for /metrics, /v1/cases, /v1/export
ADMIN_TOKEN=
# Discord webhook of the moderators' channel; without it cases stay "zalecamy przekazanie"
MODERATOR_DISCORD_WEBHOOK_URL=
CASE_ALERT_AFTER_REPEATS=3
PUBLIC_WEB_BASE_URL=http://localhost:5173
# Allowed web origins (comma-separated); set to the deployed web app URL in production
CORS_ORIGINS=*

# --- Optional external sources (docs/SOURCES.md §6) -------------------------------------
GOOGLE_FACTCHECK_API_KEY=

# --- Channels -------------------------------------------------------------------------
DISCORD_TOKEN=
