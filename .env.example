# Docker Compose runtime settings
OPENROUTER_API_KEY=
# Blank uses the backend's default model
LLM_MODEL=
# Public web URL, without the Coolify internal port suffix
PUBLIC_WEB_BASE_URL=http://localhost:8080

# Keep unverified legacy sources out of the default bootstrap.
CORPUS_ALLOW_UNVERIFIED=false

# Optional. Enable the discord profile and supply the bot token to run a second channel.
DISCORD_TOKEN=
DISCORD_GUILD_ID=
# Optional. Receives moderator alerts when configured.
MODERATOR_DISCORD_WEBHOOK_URL=
# Optional. Required for authorized metrics, case and export endpoints.
ADMIN_TOKEN=
